{
  "name": "biteright",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch backend/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "db:seed": "node backend/seed.js",
    "start": "npm run db:migrate && npm run db:seed && node backend/index.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^12.9.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prisma": "^6.19.3",
    "vite": "^6.3.1",
    "vite-plugin-pwa": "^2.0.0"
  }
}
