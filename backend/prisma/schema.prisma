datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  password         String
  name             String?
  zipcode          String
  distanceRange    Int      @default(10)
  pricePreference  String?
  dietaryTags      String[]
  swipes           Swipe[]
  preferenceProfile PreferenceProfile?
  createdAt        DateTime @default(now())
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  flavorTags  String[]
  imageUrl    String?
  restaurantDishes RestaurantDish[]
  swipes      Swipe[]
  createdAt   DateTime @default(now())
}

model Swipe {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  dish            Dish     @relation(fields: [dishId], references: [id])
  dishId          Int
  swipeDirection  String
  createdAt       DateTime @default(now())
}

model Restaurant {
  id               Int      @id @default(autoincrement())
  name             String
  address          String
  zipcode          String
  priceLevel       String
  phone            String?
  website          String?
  imageUrl         String?
  cuisine          String?   // ✅ NEW FIELD
  restaurantDishes RestaurantDish[]
  createdAt        DateTime @default(now())
}

model RestaurantDish {
  id             Int        @id @default(autoincrement())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId   Int
  dish           Dish       @relation(fields: [dishId], references: [id])
  dishId         Int
}

model PreferenceProfile {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int      @unique
  topDishCategories String[]
  topFlavorTags    String[]
  lastUpdated      DateTime @default(now())
}
